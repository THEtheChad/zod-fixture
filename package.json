{
	"$schema": "https://json.schemastore.org/package",
	"name": "zod-fixture",
	"version": "0.0.0",
	"description": "Creating fixtures based on zod schemas",
	"packageManager": "npm@10.8.1",
	"scripts": {
		"start": "vite -c vite.lib.config.mts",
		"test": "vitest run -c vite.lib.config.mts",
		"test:watch": "vitest -c vite.lib.config.mts",
		"test:ui": "vitest -c vite.lib.config.mts --ui",
		"test:coverage": "vitest run --coverage -c vite.lib.config.mts",
		"build": "vite build -c vite.lib.config.mts",
		"lint": "eslint . --max-warnings 0",
		"typecheck": "tsc --noEmit",
		"prepare": "git config core.hookspath .githooks",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"readme:generate": "node ./scripts/readme.mjs",
		"readme:check": "git diff --name-only --exit-code README.md"
	},
	"files": [
		"dist"
	],
	"main": "./dist/zod-fixture.umd.cjs",
	"module": "./dist/zod-fixture.es.mjs",
	"exports": {
		".": {
			"import": {
				"types": "./dist/public.d.mts",
				"default": "./dist/zod-fixture.es.mjs"
			},
			"require": {
				"types": "./dist/public.d.cts",
				"default": "./dist/zod-fixture.umd.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/public.d.ts",
	"keywords": [
		"zod",
		"test",
		"data",
		"generator",
		"random",
		"fake",
		"fixtures",
		"contextual",
		"stub",
		"mock",
		"schema",
		"dummy"
	],
	"author": "Tim Deschryver",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/timdeschryver/zod-fixture.git"
	},
	"bugs": {
		"url": "https://github.com/timdeschryver/zod-fixture/issues"
	},
	"homepage": "https://zod-fixture.timdeschryver.dev/",
	"private": false,
	"sideEffects": false,
	"peerDependencies": {
		"zod": ">=3.0.0"
	},
	"dependencies": {
		"randexp": "^0.5.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@microsoft/api-extractor": "^7.60.0",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "^4.1.12",
		"@vitest/ui": "^4.1.12",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"lint-staged": "^17.6.0",
		"minimist": "^1.2.8",
		"prettier": "^3.3.2",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vite-plugin-dts": "^5.1.2",
		"vitepress": "^1.6.4",
		"vitest": "^4.1.12",
		"zod": "^3.23.8"
	}
}
